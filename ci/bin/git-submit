#!/usr/bin/env bash
# git-submit: send a pinned, fetchable revision plus the exact patch to build.
set -euo pipefail

GIT_SUBMIT_VERSION="0.6.1"
me="$(basename "$0")"
cmd="git ${me#git-}"
die() { printf '%s: %s\n' "$cmd" "$*" >&2; exit 1; }

usage() {
  cat <<EOF
Usage: $cmd [pr<number>] [--dirty] [--ref <rev>] [--only <workflow>] [--workflow <id>] [--dry-run] [--submit-empty]

Submits an exact Git revision and patch to the CI orchestrator. The runner
checks out the fetchable base revision from repository.url, then applies the
patch and verifies the resulting tree.

Options:
  pr<number>        fetch and submit that GitHub pull request's exact head
  --dirty          include uncommitted tracked changes
  --submit-empty   submit even when the target tree equals the default branch
  --archive        removed: full-repository archive uploads are not supported
  --ref <rev>      submit another commit (default HEAD)
  --only <workflow> run only this workflow (repeatable)
  --workflow <id> name the workflow object this run belongs to
  --dry-run        inspect the submission without sending it
  --upgrade        reinstall from the release channel
  --version        print the client version
  -h, --help       show this

Configuration (environment wins over git config):
  CI_ENDPOINT / ci.endpoint
  CI_TOKEN / ci.token
  CI_WEBHOOK_SECRET / ci.secret
  ci.workflowPath (repeatable) adds workflow YAML globs to the default
  .ci/workflows/*.yml and .ci/workflows/*.yaml metadata set.
EOF
}

rev=HEAD; ref_selected=0; pr_number=""; dirty=0; dry_run=0; submit_empty=0; workflow=""; only=()
while [ $# -gt 0 ]; do
  case "$1" in
    --dirty) dirty=1; shift ;;
    --submit-empty) submit_empty=1; shift ;;
    --archive) die "--archive was removed: CI no longer accepts full-repository bundles or archives. Publish a base commit, then use $cmd (or $cmd --dirty)." ;;
    --dry-run) dry_run=1; shift ;;
    --ref) [ $# -ge 2 ] || die "--ref needs a revision"; rev="$2"; ref_selected=1; shift 2 ;;
    --workflow) [ $# -ge 2 ] || die "--workflow needs an id"; workflow="$2"; shift 2 ;;
    --only) [ $# -ge 2 ] || die "--only needs a workflow name"; only+=("$2"); shift 2 ;;
    --upgrade)
      installer="${GIT_SUBMIT_INSTALL_URL:-https://heyo.computer/git-submit/install.sh}"
      command -v curl >/dev/null 2>&1 || die "--upgrade needs curl"
      curl --fail --show-error --silent --location "$installer" | GIT_SUBMIT_INSTALL_SOURCE=remote bash
      exit $?
      ;;
    --version) printf '%s %s\n' "$me" "$GIT_SUBMIT_VERSION"; exit 0 ;;
    -h|--help) usage; exit 0 ;;
    pr*) pr_candidate="${1#pr}"; case "$pr_candidate" in ""|0|0*|*[!0-9]*) die "malformed pull request selector $1 (expected pr<number>, for example pr59)";; esac; [ -z "$pr_number" ] || die "only one pull request selector may be used"; pr_number="$pr_candidate"; shift ;;
    *) die "unknown argument $1 (try --help)" ;;
  esac
done

if [ -n "$pr_number" ]; then
  [ "$ref_selected" -eq 0 ] || die "pr$pr_number cannot be combined with --ref"
  [ "$dirty" -eq 0 ] || die "pr$pr_number cannot be combined with --dirty"
fi

for tool in git curl base64 python3; do command -v "$tool" >/dev/null 2>&1 || die "$tool is required but not on PATH"; done
git rev-parse --git-dir >/dev/null 2>&1 || die "not inside a git repository"

normalize_endpoint() { local value="${1%/}"; case "$value" in */api/submit) printf '%s\n' "$value";; */git/push) printf '%s/api/submit\n' "${value%/git/push}";; *) printf '%s/api/submit\n' "$value";; esac; }
ci_config_endpoint="$(git config --get ci.endpoint || true)"
cicd_config_endpoint="$(git config --get cicd.endpoint || true)"
canonical_endpoint="${CI_ENDPOINT:-$ci_config_endpoint}"
legacy_endpoint="${CICD_ENDPOINT:-$cicd_config_endpoint}"
endpoint="${canonical_endpoint:-$legacy_endpoint}"
[ -n "$endpoint" ] || die "no endpoint. Set CI_ENDPOINT or git config ci.endpoint https://ci.example.com"
submit_url="$(normalize_endpoint "$endpoint")"
if [ -n "$canonical_endpoint" ] && [ -n "$legacy_endpoint" ] && [ "$(normalize_endpoint "$canonical_endpoint")" != "$(normalize_endpoint "$legacy_endpoint")" ]; then die "conflicting endpoint settings. ci.endpoint/CI_ENDPOINT and legacy cicd.endpoint/CICD_ENDPOINT must resolve to the same public submission API"; fi
base="${submit_url%/api/submit}"
token="${CI_TOKEN:-$(git config --get ci.token || true)}"
secret="${CI_WEBHOOK_SECRET:-$(git config --get ci.secret || true)}"
[ -n "$token" ] || [ -n "$secret" ] || die "no credential. Register at $base/repos and set git config ci.token <token>"
if [ -z "$token" ]; then command -v openssl >/dev/null 2>&1 || die "openssl is required when using ci.secret"; fi

work="$(mktemp -d "${TMPDIR:-/tmp}/git-submit.XXXXXX")"
trap 'rm -rf "$work"' EXIT
repo_url="$(git config --get remote.origin.url || true)"
[ -n "$repo_url" ] || die "repository has no remote.origin.url; publish a base commit to an origin the runner can fetch"
if [ -n "$pr_number" ]; then
  pr_repo="$work/pr.git"; git init -q --bare "$pr_repo"
  git --git-dir="$pr_repo" fetch --quiet --no-tags "$repo_url" "+refs/pull/$pr_number/head:refs/heads/pr" || die "cannot fetch GitHub pull request #$pr_number from origin"
  target_commit="$(git --git-dir="$pr_repo" rev-parse refs/heads/pr)"
  git_objects="$(git rev-parse --path-format=absolute --git-path objects)"
  printf '%s\n' "$pr_repo/objects" > "$work/pr-alternate"
  export GIT_ALTERNATE_OBJECT_DIRECTORIES="$pr_repo/objects${GIT_ALTERNATE_OBJECT_DIRECTORIES:+:$GIT_ALTERNATE_OBJECT_DIRECTORIES}"
  rev="$target_commit"
else
  target_commit="$(git rev-parse --verify "$rev^{commit}" 2>/dev/null)" || die "cannot resolve $rev to a commit"
fi
original_commit="$target_commit"
branch="$(git symbolic-ref --quiet --short HEAD 2>/dev/null || printf detached)"
[ -z "$pr_number" ] || branch="pull/$pr_number"
repo_name="$(basename "$(git rev-parse --show-toplevel)")"
default_branch="$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null | sed 's#^origin/##' || true)"
release_base=""; [ -z "$default_branch" ] || release_base="$(git ls-remote "$repo_url" "refs/heads/$default_branch" | awk 'NR==1{print $1}')"
before="$(git rev-parse --verify "${rev}^" 2>/dev/null || true)"
pusher_name="$(git config --get user.name || true)"; pusher_email="$(git config --get user.email || true)"

# A private index makes --dirty include tracked worktree changes without
# modifying HEAD, the user's index, or any refs.
if [ "$dirty" -eq 1 ]; then
  GIT_INDEX_FILE="$work/index" git read-tree "$target_commit"
  GIT_INDEX_FILE="$work/index" git add -u
  target_tree="$(GIT_INDEX_FILE="$work/index" git write-tree)"
  target_commit="$(printf 'git submit --dirty\n' | git commit-tree "$target_tree" -p "$original_commit")"
  after="$original_commit-dirty"
else
  target_tree="$(git rev-parse "$target_commit^{tree}")"
  after="$original_commit"
fi

# Inspect the remote itself, not possibly stale origin/* tracking refs. Fetch
# advertised heads into a temporary repository whose alternates can also see
# local-only target objects. This changes neither FETCH_HEAD nor refs locally.
remote_heads="$work/remote-heads"
git ls-remote --heads origin > "$remote_heads" 2>/dev/null || die "cannot inspect origin; publish a base commit and ensure your repository credentials can read it"
[ -s "$remote_heads" ] || die "origin advertises no branches. Publish a base commit before submitting; full-repository upload fallback is disabled"
pack="$work/base.git"; git init -q --bare "$pack"
git_objects="$(git rev-parse --path-format=absolute --git-path objects)"
printf '%s\n' "$git_objects" > "$pack/objects/info/alternates"
git --git-dir="$pack" fetch -q --no-tags "$repo_url" '+refs/heads/*:refs/remotes/submit/*' \
  || die "origin branches could not be fetched; fix repository access before submitting"

if [ "$submit_empty" -eq 0 ]; then
  for main in ${default_branch:+"$default_branch"} main master; do
    main_ref="refs/remotes/submit/$main"
    if git --git-dir="$pack" rev-parse --verify --quiet "$main_ref^{commit}" >/dev/null; then
      if git --git-dir="$pack" diff --quiet "$main_ref" "$target_commit" --; then
        die "the submitted tree equals $main; use --submit-empty to run it deliberately"
      fi
      break
    fi
  done
fi

base_revision=""
# Published commits use themselves as the base and carry an empty patch.
if git --git-dir="$pack" for-each-ref --contains "$original_commit" --format='%(refname)' refs/remotes/submit 2>/dev/null | grep -q .; then
  base_revision="$original_commit"
else
  best_count=""
  # Minimal Linux guests may not provide /dev/fd for process substitution.
  git --git-dir="$pack" for-each-ref --format='%(objectname)' refs/remotes/submit | sort -u > "$work/remote-tips"
  while read -r remote_tip; do
    candidate="$(git --git-dir="$pack" merge-base "$remote_tip" "$target_commit" 2>/dev/null || true)"
    if [ -n "$candidate" ] && git --git-dir="$pack" merge-base --is-ancestor "$candidate" "$target_commit" 2>/dev/null; then
      count="$(git --git-dir="$pack" rev-list --count "$candidate..$target_commit")"
      if [ -z "$best_count" ] || [ "$count" -lt "$best_count" ]; then base_revision="$candidate"; best_count="$count"; fi
    fi
  done < "$work/remote-tips"
fi
[ -n "$base_revision" ] || die "no fetchable published commit is an ancestor of $rev. Push a base commit/branch to origin first; full-repository upload fallback is disabled"
git --git-dir="$pack" cat-file -e "$base_revision^{commit}" 2>/dev/null || die "selected base $base_revision could not be verified after fetching origin"

patch="$work/source.patch"
if [ "$base_revision" = "$target_commit" ] && [ "$dirty" -eq 0 ]; then : > "$patch"; else git --git-dir="$pack" diff --binary --full-index "$base_revision" "$target_commit" -- > "$patch"; fi

# Enumerate from the target tree (including the private dirty tree), never from
# the ambient filesystem. Python validates paths/text and caps metadata at 1MiB.
git ls-tree -rz --name-only "$target_tree" > "$work/tree-paths"
printf '%s\n' '.ci/workflows/*.yml' '.ci/workflows/*.yaml' > "$work/workflow-globs"
git config --get-all ci.workflowPath >> "$work/workflow-globs" 2>/dev/null || true
if [ -n "${CI_WORKFLOW_PATHS:-}" ]; then printf '%s\n' "$CI_WORKFLOW_PATHS" | tr ',' '\n' >> "$work/workflow-globs"; fi

# A release validates the complete branch diff, not just its last commit.
# Keep the previous-commit range for an explicitly resubmitted trunk revision
# so a failed deployment can still request validation of that revision.
if [ -n "$release_base" ] && [ "$release_base" != "$target_commit" ]; then
  before="$release_base"
fi
# Unrepresentable or very large path sets are explicitly unknown, not truncated.
if [ -n "$before" ] && git --git-dir="$pack" cat-file -e "$before^{commit}" 2>/dev/null; then
  git --git-dir="$pack" diff --no-renames --name-only -z "$before" "$target_commit" -- > "$work/changes"
  changes_reason=""
else
  : > "$work/changes"; changes_reason="the submitted revision has no parent available"
fi

descriptor="$work/descriptor.json"
BASE_REVISION="$base_revision" TARGET_TREE="$target_tree" CHANGES_REASON="$changes_reason" python3 - "$work" <<'PY'
import base64, json, os, pathlib, subprocess, sys
w=sys.argv[1]
def safe_path(raw):
    try: p=raw.decode('utf-8')
    except UnicodeDecodeError: return None
    if not p or p.startswith('/') or '\\' in p or any(x in ('','.','..') for x in p.split('/')): return None
    return p
globs=[x.strip() for x in open(w+'/workflow-globs', encoding='utf-8') if x.strip()]
paths=[]
for raw in open(w+'/tree-paths','rb').read().split(b'\0'):
    if raw:
        p=safe_path(raw)
        if p is not None: paths.append(p)
workflows={}; total=0
for p in paths:
    if not p.lower().endswith(('.yml','.yaml')) or not any(pathlib.PurePosixPath(p).match(g) for g in globs): continue
    data=subprocess.check_output(['git','show',os.environ['TARGET_TREE']+':'+p])
    try: text=data.decode('utf-8')
    except UnicodeDecodeError: raise SystemExit('workflow metadata is not UTF-8: '+p)
    total += len(data)
    if len(data)>262144 or total>1048576: raise SystemExit('workflow metadata exceeds the 1 MiB submission limit')
    workflows[p]=text
reason=os.environ.get('CHANGES_REASON','')
raw_changes=open(w+'/changes','rb').read().split(b'\0') if not reason else []
change_paths=[]
if not reason:
    for raw in raw_changes:
        if not raw: continue
        p=safe_path(raw)
        if p is None: reason='changed paths are not safe UTF-8 relative paths'; break
        change_paths.append(p)
        if len(change_paths)>5000: reason='more than 5000 paths changed'; break
changes={'kind':'unknown','reason':reason} if reason else {'kind':'known','paths':change_paths}
d={'baseRevision':os.environ['BASE_REVISION'],'targetTree':os.environ['TARGET_TREE'],
   'patchBase64':base64.b64encode(open(w+'/source.patch','rb').read()).decode(),
   'workflows':workflows,'changes':changes}
open(w+'/descriptor.json','w',encoding='utf-8').write(json.dumps(d,separators=(',',':')))
PY

payload="$work/payload.json"
REPO_NAME="$repo_name" REPO_URL="$repo_url" DEFAULT_BRANCH="$default_branch" BRANCH="$branch" BEFORE="$before" AFTER="$after" \
PUSHER_NAME="$pusher_name" PUSHER_EMAIL="$pusher_email" RELEASE_BASE="$release_base" WORKFLOW="$workflow" ONLY_FILE="$work/only" DESCRIPTOR="$descriptor" PAYLOAD="$payload" python3 - <<'PY'
import base64,json,os
open(os.environ['ONLY_FILE'],'w').write('')
only=json.loads(os.environ.get('ONLY_JSON','[]')) if os.environ.get('ONLY_JSON') else []
d=json.load(open(os.environ['DESCRIPTOR']))
p={'repository':{'id':os.environ['REPO_NAME'],'name':os.environ['REPO_NAME'],'url':os.environ['REPO_URL'],'defaultBranch':os.environ['DEFAULT_BRANCH'] or None,'releaseBaseSha':os.environ['RELEASE_BASE'] or None},
   'ref':'refs/heads/'+os.environ['BRANCH'],'before':os.environ['BEFORE'],'after':os.environ['AFTER'],'dryRun':False,
   'pusher':{'name':os.environ['PUSHER_NAME'],'email':os.environ['PUSHER_EMAIL']},'workflowId':os.environ['WORKFLOW'] or None,
   'only':only,'source':{'format':'git-patch','contentBase64':base64.b64encode(json.dumps(d,separators=(',',':')).encode()).decode()}}
open(os.environ['PAYLOAD'],'w').write(json.dumps(p,separators=(',',':')))
PY
# Inject --only without passing potentially large values through argv/env.
python3 - "$payload" "${only[@]}" <<'PY'
import json,sys
p=json.load(open(sys.argv[1])); p['only']=sys.argv[2:]; open(sys.argv[1],'w').write(json.dumps(p,separators=(',',':')))
PY

size="$(wc -c < "$patch" | tr -d ' ')"
if [ "$dry_run" -eq 1 ]; then
  printf 'would submit to %s\n  repository %s (%s)\n  ref        refs/heads/%s\n  commit     %s\n  base       %s\n  tree       %s\n  source     git-patch, %s patch bytes\n' "$submit_url" "$repo_name" "$repo_url" "$branch" "$after" "$base_revision" "$target_tree" "$size"
  [ "${#only[@]}" -gt 0 ] && printf '  only       %s\n' "${only[*]}"
  exit 0
fi

auth_config="$work/auth.conf"; umask 077
if [ -n "$token" ]; then printf 'header = "authorization: Bearer %s"\n' "$token" > "$auth_config"; else
  signature="sha256=$(openssl dgst -sha256 -hmac "$secret" -binary < "$payload" | od -An -tx1 | tr -d ' \n')"
  printf 'header = "x-heyo-signature-256: %s"\n' "$signature" > "$auth_config"
fi
response="$work/response.json"
code="$(curl --silent --show-error --output "$response" --write-out '%{http_code}' --max-time "${CI_SUBMIT_TIMEOUT:-300}" -X POST "$submit_url" -H 'content-type: application/json' -H "x-heyo-git-ci-version: $GIT_SUBMIT_VERSION" --config "$auth_config" --data-binary "@$payload")" || die "could not reach $submit_url"
if [ "$code" -ge 400 ]; then cat "$response" >&2; printf '\n' >&2; die "submit rejected (HTTP $code)"; fi
printf 'submitted %s on %s (%s patch bytes)\n' "${after:0:12}" "$branch" "$size"
if python3 -m json.tool "$response" >/dev/null 2>&1; then
  python3 - "$response" <<'PY'
import json,sys
r=json.load(open(sys.argv[1]))
for w in r.get('warnings',[]): print('warning: '+w,file=sys.stderr)
for run in r.get('runs',[]): print('  run %s  %sruns/%s'%(run,r.get('url',''),run))
if r.get('submission'):
    print('  submission (validation, merge, deployment): %sruns/%s'%(r.get('url',''),r['submission']))
PY
else cat "$response"; fi
