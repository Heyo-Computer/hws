{
  "rollout_revision": "persisted-opaque-revision",
  "spec": {
    "id": "search",
    "routes": [
      {
        "host": "sandbox.example.com"
      },
      {
        "host_suffix": "sb.example.com",
        "path_prefix": "/api"
      }
    ],
    "vm": {
      "driver": "firecracker",
      "image": "agent-base",
      "port": 8080,
      "start_command": "/usr/local/bin/agent serve",
      "size_class": "medium",
      "disk_size_gb": 20,
      "working_directory": "/workspace",
      "env_vars": {
        "RUST_LOG": "info"
      },
      "setup_hooks": [
        "apt-get update"
      ],
      "open_ports": [
        9229
      ],
      "mounts": [
        {
          "path": "/data/corpus",
          "store": "http://127.0.0.1:8080",
          "ref": "corpus-2026-08",
          "auth": {
            "secret": "art-key",
            "key": "token"
          },
          "strip_components": 1,
          "read_only": true,
          "digest": "0f1e2d3c4b5a69788796a5b4c3d2e1f00f1e2d3c4b5a69788796a5b4c3d2e1f0"
        }
      ],
      "ttl_seconds": 86400
    },
    "scaling": {
      "min_replicas": 0,
      "max_replicas": 1,
      "warm_pool": 0,
      "target_concurrency": 1,
      "scale_to_zero_after_secs": 900,
      "cold_start_timeout_secs": 120,
      "drain_timeout_secs": 30,
      "boot_timeout_secs": 300,
      "idle_action": "retain"
    },
    "health": {
      "expected_header": {
        "name": "x-heyo-revision",
        "value": "0123456789abcdef0123456789abcdef01234567"
      },
      "path": "/healthz",
      "port": 8080,
      "timeout_secs": 2
    },
    "auth": {
      "provider": [
        "google",
        "jwt"
      ],
      "client_id": "1234.apps.googleusercontent.com",
      "client_secret": {
        "secret": "google-oauth",
        "key": "client_secret"
      },
      "allowed_domains": [
        "example.com"
      ],
      "public_paths": [
        {
          "path": "/healthz",
          "scope": "admin"
        }
      ],
      "base_path": "/__applb/auth",
      "session_ttl_secs": 43200,
      "cookie_name": "applb_session",
      "forward_identity": true,
      "jwt": {
        "secret": {
          "secret": "heyo-auth",
          "key": "jwt_secret"
        },
        "algorithms": [
          "HS256"
        ],
        "issuer": "auth-service",
        "audience": "heyo-app",
        "require": {
          "accountId": "acct_7f3c",
          "role": [
            "user",
            "admin"
          ]
        },
        "subject_claim": "userId",
        "email_claim": "email",
        "name_claim": "name",
        "leeway_secs": 30,
        "cookie": "heyo_access_token",
        "login_url": "https://auth.example.com/login"
      }
    }
  },
  "kind": "vm",
  "desired_replicas": 1,
  "ready": 1,
  "pending": 1,
  "total_in_flight": 3,
  "vms": [
    {
      "sandbox_id": "applb-sandbox-a1b2c3",
      "addr": "172.16.0.4:8080",
      "in_flight": 3,
      "healthy": true,
      "draining": false
    }
  ],
  "pending_vms": [
    {
      "sandbox_id": "applb-sandbox-d4e5f6",
      "age_secs": 12,
      "status": "running"
    }
  ]
}
