{
  "id": "artifacts-us3",
  "routes": [],
  "vm": {
    "driver": "firecracker",
    "image": "REPLACE_WITH_VERIFIED_RUNTIME_IMAGE",
    "port": 8080,
    "start_command": "setsid nohup /usr/local/bin/art serve </dev/null >/var/log/art.log 2>&1 &",
    "size_class": "small",
    "disk_size_gb": 40,
    "ttl_seconds": 0,
    "env_vars": {
      "ART_ROOT": "/workspace/store",
      "ART_LISTEN": "0.0.0.0:8080",
      "ART_MIN_FREE_BYTES": "536870912",
      "ART_S3_BUCKET": "REPLACE_WITH_GLOBAL_ARTIFACTS_BUCKET",
      "ART_S3_PREFIX": "art/",
      "ART_S3_REGION": "REPLACE_WITH_BUCKET_REGION",
      "ART_CACHE_MAX_BYTES": "32212254720",
      "ART_HUB": "1",
      "ART_HUB_HOST": "hub.heyo.work"
    },
    "env_from": [
      {"secret": "artifacts", "key": "api-key", "as": "ART_API_KEY"},
      {"secret": "artifacts-s3", "key": "access-key-id", "as": "ART_S3_ACCESS_KEY_ID"},
      {"secret": "artifacts-s3", "key": "secret-access-key", "as": "ART_S3_SECRET_ACCESS_KEY"}
    ]
  },
  "build": {
    "repo": "https://github.com/Heyo-Computer/heyo-public.git",
    "ref": "REPLACE_WITH_COMMIT",
    "dockerfile": "artifacts/Dockerfile",
    "context": ".",
    "image_size_mb": 768
  },
  "scaling": {"min_replicas": 0, "max_replicas": 1, "warm_pool": 0, "scale_to_zero_after_secs": 0},
  "health": {"path": "/healthz", "timeout_secs": 2}
}
